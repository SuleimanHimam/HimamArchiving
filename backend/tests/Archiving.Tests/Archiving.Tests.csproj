    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Archiving.Infrastructure\Archiving.Infrastructure.csproj" />
  </ItemGroup>

</Project>
