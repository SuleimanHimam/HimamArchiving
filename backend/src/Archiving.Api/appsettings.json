{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "server=localhost;port=3306;database=archiving_db;uid=archiver;pwd=CHANGE_ME;SslMode=Required;"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "License": {
    "Path": "license.lic",
    "PublicKey": "",
    "Enforcement": "ReadOnly",
    "RecheckInterval": "00:05:00"
  },
  "Kms": {
    "//": "Encryption is mandatory and has no off switch. This default targets a Windows host; the service refuses to start if the keyring cannot be opened, rather than silently archiving documents unencrypted.",
    "Provider": "DpapiKeyring",
    "KeyringPath": "C:\\ArchivingData\\keys\\keyring.dat",
    "RotationIntervalDays": 90,
    "RewrapBatchSize": 500
  },

  "Storage": {
    "RootPath": "",
    "ChunkSizeBytes": 1048576
  },

  "Jwt": {
    "Issuer": "Archiving.Api",
    "Audience": "Archiving.Client",
    "Key": "CHANGE_ME-set-a-long-random-secret-at-least-32-chars-in-appsettings.Development.json",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  }
}
