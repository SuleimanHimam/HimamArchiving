<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: the agent shows a tray icon and normally starts at login, so a console
         window flashing on every sign-in would be noise. The console switch re-attaches to the
         parent terminal for anyone who still wants the headless behaviour. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>archiving-scan-agent</AssemblyName>
    <!-- Read by ApplicationConfiguration.Initialize(). Without PerMonitorV2 the window renders
         blurry on the scaled displays most laptops ship with. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <!-- WIA is accessed through late-bound COM (no interop assembly needed). -->
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Printing: enumerate queues + render/print pages. PDFtoImage rasterizes PDFs so the
         agent prints them without any external app (System.Drawing handles spooling).
         System.Drawing itself now comes from the Windows Desktop framework reference that
         UseWindowsForms brings in, so the old System.Drawing.Common package reference is gone. -->
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
  </ItemGroup>

</Project>
