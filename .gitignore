# ---- .NET build output ----
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# ---- Published / packaged artifacts ----
tools/scan-agent/publish/

# ---- Vendored third-party tool (phpMyAdmin) — not part of this project ----
tools/phpmyadmin/

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/.env.local
frontend/rcheck/
*.log

# ---- Runtime data (uploaded files, scans) ----
storage/
**/storage/
# …but not the storage *source code*. Git on Windows matches these patterns case-insensitively, so
# the lines above also hid Archiving.Infrastructure/Storage/ and a fresh clone could not build.
!backend/src/Archiving.Infrastructure/Storage/

# ---- Deployment output ----
# The packaged build (self-contained runtime + SPA + generated settings) — hundreds of MB, and
# appsettings.Production.json inside it holds this installation's JWT and storage keys.
dist/

# ---- Local secrets / overrides ----
# Holds the real DB password + JWT key + machine-specific paths. Use the .example as a template.
appsettings.Development.json
appsettings.Production.json
appsettings.Local.json
appsettings.*.user.json
secrets.json

# ---- Misc / temp ----
_shot.mjs
*.tmp
# Vite's dependency cache, written wherever the dev server was started from.
.vite/
# One-off Playwright screenshot scripts and their output — local checks, not part of the project.
/phtest.mjs
/shot.mjs
frontend/_*.mjs
frontend/.brand.mjs
frontend/zoom.mjs
frontend/fc-shot.mjs
frontend/fc-demo.html
frontend/*.png
.DS_Store
Thumbs.db

# Local database dumps — contain password hashes and refresh tokens.
backups/

# ---- Licensing ----
# Signing keys never belong in the repo: the private key can mint licences for anyone.
license-private.pem
license-public.txt
# Issued licences are per-customer, per-machine artefacts.
*.lic
