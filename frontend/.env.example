# Frontend build-time configuration (Vite). Copy to .env.local and adjust.
# Every value here is baked into the bundle at build time — nothing secret belongs in this file.

# Where the SPA calls the API. The packaged deployment serves both from one origin, so the
# published build uses /api and this is only needed for development or a split origin.
VITE_API_URL=http://localhost:5105/api

# ── Session security ──────────────────────────────────────────────────────────
# Quiet time before the "are you still there?" warning appears, in milliseconds.
# Default: 900000 (15 minutes).
VITE_IDLE_TIMEOUT_MS=900000

# How long that warning counts down before the session is ended, in milliseconds.
# Default: 60000 (60 seconds).
VITE_IDLE_WARNING_MS=60000

# Ask before the window closes. Closing the desktop-program window ends the session (the token
# lives in sessionStorage), so it confirms first — but only in that window, since the same prompt
# on every browser tab close is one users learn to dismiss without reading.
#   standalone (default) · only in the installed / --app window
#   always               · in ordinary browser tabs too
#   never                · off
# The wording is the browser's own; a page cannot supply custom text for this prompt, and it also
# appears on a manual reload because a page cannot tell a reload from a close.
VITE_CONFIRM_ON_CLOSE=standalone

# Both idle values are validated at load: a non-numeric or non-positive value falls back to the default rather
# than disabling the timer, so a typo cannot silently leave sessions open forever.
#
# Keep them well below the API's Jwt:AccessTokenMinutes (60 by default). The idle timer is what
# should end sessions during use; token expiry is the backstop for a client that vanished.
